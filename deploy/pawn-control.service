[Unit]
Description=Pawn Control chess broadcast desk
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pawn
Group=pawn
StateDirectory=pawn-control
StateDirectoryMode=0750
WorkingDirectory=/opt/pawn_control
Environment=DATA_DIR=/var/lib/pawn-control
EnvironmentFile=/opt/pawn_control/.env
ExecStart=/usr/bin/node /opt/pawn_control/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pawn-control
UMask=0077

[Install]
WantedBy=multi-user.target
