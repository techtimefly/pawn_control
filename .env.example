HOST=127.0.0.1
PORT=3000
# true (default): require control/dock login and overlay/credits URL tokens.
# false: no login or URL tokens; use only on a trusted LAN.
# Only true/false are accepted. Restart the app after changing this value.
AUTH_REQUIRED=true
# Required only when AUTH_REQUIRED=true; ignored when false.
# CONTROL_PASSWORD: 16-1024 characters. OVERLAY_TOKEN: at least 24 characters.
CONTROL_PASSWORD=replace-with-a-long-unique-password
OVERLAY_TOKEN=replace-with-a-long-random-overlay-token
CHESS_USERNAME=your_chess_username
DATA_DIR=./data
COOKIE_SECURE=false
CHESS_USER_AGENT=PawnControl/1.0
