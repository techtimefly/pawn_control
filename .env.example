HOST=127.0.0.1
PORT=3000
# Set false for trusted LAN use: no control login or overlay/credits token required.
AUTH_REQUIRED=true
CONTROL_PASSWORD=replace-with-a-long-unique-password
OVERLAY_TOKEN=replace-with-a-long-random-overlay-token
CHESS_USERNAME=your_chess_username
DATA_DIR=./data
COOKIE_SECURE=false
CHESS_USER_AGENT=PawnControl/1.0
